# ─── Dependencies (reinstalled inside container) ─────────────────────────────
**/node_modules

# ─── Build outputs ───────────────────────────────────────────────────────────
**/dist
**/*.tsbuildinfo

# ─── Environment files ───────────────────────────────────────────────────────
**/.env
**/.env.*
!**/.env.example

# ─── Test & coverage artifacts ───────────────────────────────────────────────
**/coverage
**/.nyc_output
**/cypress/screenshots
**/cypress/videos
frontend/cypress
frontend/cypress.config.ts

# ─── Backend source (not needed for frontend build) ──────────────────────────
# backend/package.json IS needed by pnpm workspace install — keep it.
backend/src
backend/prisma
backend/tsup.config.ts
backend/vitest.config.ts
backend/tsconfig.json
backend/eslint.config.js
backend/Dockerfile
backend/Dockerfile.dev

# ─── Monitoring / infra config ────────────────────────────────────────────────
docker

# ─── CI config ────────────────────────────────────────────────────────────────
.github

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Mobile build artifacts ──────────────────────────────────────────────────
android
ios

# ─── SQLite test databases ────────────────────────────────────────────────────
*.db
*.db-journal
*.db-shm
*.db-wal
