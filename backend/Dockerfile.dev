# Lingo2 Backend — Development Dockerfile with hot reload
# Build context: monorepo root  (docker compose up — context: .)
FROM node:22-alpine

RUN corepack enable pnpm

WORKDIR /app

# Install all workspace deps using the root lockfile.
# Source files are bind-mounted at runtime; only manifests are baked in.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json  ./backend/
COPY frontend/package.json ./frontend/
COPY shared/package.json   ./shared/
# prisma generate runs as backend postinstall — schema must exist before install.
COPY backend/prisma/schema.prisma ./backend/prisma/schema.prisma
# postinstall runs `prisma generate` automatically.
RUN pnpm install --frozen-lockfile

WORKDIR /app/backend

EXPOSE 3000

CMD ["pnpm", "dev"]
