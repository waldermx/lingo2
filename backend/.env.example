# ─────────────────────────────────────────────────────────────────────────────
# Lingo2 Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is listed in .gitignore and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Development: SQLite  (relative path)
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL
# DATABASE_URL="postgresql://lingo2:CHANGE_ME@postgres:5432/lingo2?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_BYTES_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET_ALSO_64_BYTES

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (not recommended for prod)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8100
