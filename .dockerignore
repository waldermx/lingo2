# ─── Version control ─────────────────────────────────────────────────────────
.git
.github

# ─── Dependencies (reinstalled inside container) ─────────────────────────────
**/node_modules

# ─── Build outputs ───────────────────────────────────────────────────────────
**/dist
**/*.tsbuildinfo

# ─── Environment files ───────────────────────────────────────────────────────
**/.env
**/.env.*
!**/.env.example

# ─── Test & coverage artifacts ───────────────────────────────────────────────
**/coverage
**/.nyc_output
**/cypress/screenshots
**/cypress/videos

# ─── Frontend source (not needed for the API build) ──────────────────────────
# frontend/package.json IS needed by pnpm workspace install — keep it.
frontend/src
frontend/cypress
frontend/public
frontend/resources
frontend/capacitor.config.ts
frontend/cypress.config.ts
frontend/ionic.config.json
frontend/tsconfig*.json
frontend/vite.config.ts
frontend/index.html

# ─── Monitoring / infra config ────────────────────────────────────────────────
docker

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Mobile build artifacts ──────────────────────────────────────────────────
android
ios
